# Portal sign-in (required in production)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Lets the portal and the submit form write to data/ via commits (free).
# Fine-grained personal access token → Repository access: only this repo → Permissions: Contents: Read and write.
GITHUB_TOKEN=
# Optional: defaults to ElliotDaemon/ai-tree-library and the deployed branch.
# GITHUB_REPO=ElliotDaemon/ai-tree-library
# GITHUB_BRANCH=main

# Optional spam guard on /submit (Cloudflare Turnstile, free). Honeypot + rate limit work without it.
# TURNSTILE_SECRET_KEY=
